# Required — the portal can run arbitrary commands, so lock it down.
PORTAL_PASSWORD=change-me
# Keeps sessions valid across restarts: openssl rand -hex 32
PORTAL_SECRET=

# Where your workspaces live on the host
WORKSPACES_DIR=/root/repos

# host = pi runs inside the portal container (fast, full access to mounted repos)
# container = one isolated container per task (needs the docker socket mount)
EXECUTOR=host

PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=

# A local llama.cpp server, if you run one. Reachable from inside the container
# at the same address as on the host, because the container shares its network.
LLAMA_BASE_URL=http://127.0.0.1:8080

# The agent's browser. Log in through the web UI once; the profile persists and
# every later run finds itself already signed in.
BROWSER_USER=agent
BROWSER_PASSWORD=change-me
BROWSER_PORT=3010
BROWSER_HTTPS_PORT=3011
